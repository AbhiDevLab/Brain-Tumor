.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.log
.DS_Store
Thumbs.db

# Keep local credentials out of Git.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Datasets, manifests with identifiers, and generated model outputs stay local.
data/**
!data/.keep
artifacts/**
!artifacts/.keep

# Model checkpoints must use private artifact storage, never ordinary Git history.
*.pt
*.pth
*.ckpt
*.safetensors
